PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=mongodb://127.0.0.1/template-ecommerce

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000   # production: https://ca7.io
NEXT_PUBLIC_SERVER_URL=http://localhost:3000   # production: https://ca7.io

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# CA7 chat: an Ollama-compatible server that has the "ca7" model (see ai/ca7/README.md)
CA7_API_URL=http://127.0.0.1:11434
CA7_MODEL=ca7

# Marketplace API (src/api of CerveauAnalytique/Marketplace) and its web app (login, publish)
MARKETPLACE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MARKETPLACE_WEB_URL=http://127.0.0.1:5011

# /admin is hidden: it only opens through the admin's private link (Account settings > Open admin panel).
# Set to 'off' to disable the gate.
# ADMIN_GATE=off

# Mollie (iDEAL, Bancontact, cards, ...). Create a key at https://my.mollie.com/dashboard/developers/api-keys
# Use a test_ key first. For the webhook and redirect the site URL must be public https.
MOLLIE_API_KEY=test_
NEXT_PUBLIC_MOLLIE_ENABLED=false

# CA7 chat limits (requests per 10 minutes)
CA7_CHAT_LIMIT_ANON=10
CA7_CHAT_LIMIT_USER=60

# Set to 1 to start/build against a dev database without running src/migrations (see DEPLOY.md)
# PAYLOAD_SKIP_MIGRATIONS=1
