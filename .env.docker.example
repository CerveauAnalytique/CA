# Copy to .env and fill in. Used by docker-compose.yml (and read by the backend container).

# --- required -------------------------------------------------------------
DB_PASSWORD=change-me-long-random
# signs logins and the private admin link; never change it later
PAYLOAD_SECRET=change-me-long-random-64-chars
# address people use in the browser, no trailing slash (with a domain: https://cloud.ca7.io)
PUBLIC_URL=http://localhost
WEB_PORT=80

# --- recommended ----------------------------------------------------------
# lets the scheduler sync sources and clean old security events
CA7_CRON_SECRET=change-me-long-random
SECURITY_ALERT_EMAIL=
SECURITY_RETENTION_DAYS=180
SUPPORT_EMAIL=

# --- e-mail (password reset, alerts) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# --- payments -------------------------------------------------------------
MOLLIE_API_KEY=
NEXT_PUBLIC_MOLLIE_ENABLED=true
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=

# --- AI model (docker compose --profile ai up -d) -------------------------
# bigger = better answers, more RAM: qwen2.5:3b (4 GB), qwen2.5:7b (8 GB), qwen2.5:14b (16 GB)
CA7_BASE=qwen2.5:3b
CA7_MODEL=ca7

# --- domains of the chat-only sites (built into the website) --------------
CA7_CHAT_HOSTS=ca7.io,ca7.nl,ca7.be
CA7_CLOUD_HOST=cloud.ca7.io
# only when the backend has its own address (then the website calls it directly)
CA7_API=
# 1 = put a few demo products in an empty shop on first start
CA7_DEMO_SHOP=

# --- optional platform tools (docs: platform/README.md) -------------------
TIMESCALE_PASSWORD=
OPENREMOTE_URL=
DIFY_URL=
AIRBYTE_URL=
THINGSBOARD_URL=
CA7_OIDC_PRIVATE_KEY=
CA7_OIDC_CLIENTS=[]
