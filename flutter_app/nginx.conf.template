# ${BACKEND_URL} is filled in by the nginx image from the environment.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 25m;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript application/wasm image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # the backend: API, admin panel, its assets and previews
  location ~ ^/(api|admin|_next|next)(/|$) {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 180s;
    proxy_buffering off;   # the chat answer is streamed
  }
  # the private admin link /{name}/ad/{token}
  location ~ ^/[^/]+/ad/[^/]+$ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location ^~ /media/ {
    proxy_pass ${BACKEND_URL};
  }
  # the Phylena brand kit (public/brand in the backend), also used by the admin panel
  location ^~ /brand/ {
    proxy_pass ${BACKEND_URL};
  }

  # the app's code keeps the same file names after every update: the browser must check them each time,
  # or visitors keep seeing the old site (they get a fresh copy only when the file changed)
  location ~* ^/(main\.dart\.(js|mjs|wasm)|flutter_bootstrap\.js|flutter\.js|flutter_service_worker\.js|version\.json|manifest\.json|assets/AssetManifest\.[a-z.]+|assets/FontManifest\.json|assets/assets/i18n/.*\.json)$ {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }
  # the app: other files (images, fonts) are cached, every other address opens index.html (the app does its own routing)
  location ~* \.(js|wasm|css|svg|png|jpg|woff2?|ttf|otf|json)$ {
    expires 7d;
    add_header Cache-Control "public";
    try_files $uri =404;
  }
  location = /index.html { add_header Cache-Control "no-cache"; }
  location / { try_files $uri /index.html; }
}
